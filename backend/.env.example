# ─────────────────────────────────────────
#  Application
# ─────────────────────────────────────────
APP_PORT=8080
APP_HOST=localhost
APP_ENV=development

# ─────────────────────────────────────────
#  MinIO / S3-Compatible Storage
# ─────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_REGION=
MINIO_BUCKET=demo-bucket

# Presigned URL expiry (dalam detik, default 3600 = 1 jam)
MINIO_PRESIGN_EXPIRY=3600

# ─────────────────────────────────────────
#  API CORS — pisahkan dengan koma jika lebih dari satu
# ─────────────────────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:5173

# Compatibility for legacy .env files. Prefer CORS_ALLOW_ORIGINS above.
# MINIO_CORS_ALLOW_ORIGINS=http://localhost:5173

# Production example. Do not add http:// or https:// to MINIO_ENDPOINT.
# APP_HOST=0.0.0.0
# MINIO_ENDPOINT=storage.example.com
# MINIO_USE_SSL=true
# CORS_ALLOW_ORIGINS=https://app.example.com
